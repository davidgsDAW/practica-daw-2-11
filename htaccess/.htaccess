
<Files "wp-config.php">
    Require all denied
</Files>


<Files "wp-login.php">
    Require ip IP_ADMIN_HERE
</Files>


<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
